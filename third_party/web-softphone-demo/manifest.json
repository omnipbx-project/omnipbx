{
  "manifest_version": 3,
  "name": "OmniPBX Webphone",
  "version": "2.1.1",
  "description": "OmniPBX browser webphone with a persistent floating dialer, click-to-call, and SIP over WSS/WebRTC.",
  "permissions": [
    "storage",
    "notifications",
    "contextMenus",
    "clipboardWrite",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Web Softphone"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "floating.html",
        "softphone.css",
        "softphone.js",
        "jssip.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
