#!/usr/bin/env python3
from __future__ import annotations

import argparse
import getpass
import os
import secrets
import subprocess
import sys
import time
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parent.parent
DEPLOY_DIR = REPO_ROOT / "deploy"
COMPOSE_FILE = DEPLOY_DIR / "compose.yaml"
APP_WORKDIR = "/opt/omnipbx"
DEFAULT_SERVICES = ("postgres", "app", "caddy")


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="omnipbxctl",
        description="OmniPBX recovery and maintenance helper.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    reset_parser = subparsers.add_parser(
        "reset-admin-password",
        help="Reset an admin password from the host using the running app container.",
    )
    reset_parser.add_argument("username", help="Admin username to reset.")
    reset_group = reset_parser.add_mutually_exclusive_group()
    reset_group.add_argument(
        "--password",
        help="New password to apply. If omitted, you will be prompted securely.",
    )
    reset_group.add_argument(
        "--generate",
        action="store_true",
        help="Generate a strong random password and print it once.",
    )
    reset_parser.add_argument(
        "--compose-file",
        default=str(COMPOSE_FILE),
        help="Path to the compose file. Defaults to deploy/compose.yaml.",
    )
    reset_parser.add_argument(
        "--project-directory",
        default=str(DEPLOY_DIR),
        help="Docker Compose project directory. Defaults to deploy/.",
    )

    update_parser = subparsers.add_parser(
        "update",
        help="Check for and apply OmniPBX updates.",
    )
    update_parser.add_argument(
        "--project-root",
        default=str(REPO_ROOT),
        help="Installed OmniPBX project root. Defaults to the omnipbxctl parent directory.",
    )
    update_parser.add_argument(
        "--check-only",
        action="store_true",
        help="Check the tracked git branch without applying an update.",
    )
    update_parser.add_argument(
        "--force",
        action="store_true",
        help="Restart the stack even when the tracked branch is already current.",
    )
    update_parser.add_argument(
        "--non-interactive",
        action="store_true",
        help="Skip confirmation prompts.",
    )

    restart_parser = subparsers.add_parser(
        "restart",
        help="Restart the OmniPBX Docker Compose stack.",
    )
    restart_parser.add_argument(
        "services",
        nargs="*",
        default=list(DEFAULT_SERVICES),
        help="Optional Compose services to restart. Defaults to postgres app caddy.",
    )
    restart_parser.add_argument(
        "--project-root",
        default=str(REPO_ROOT),
        help="OmniPBX project root. Defaults to the omnipbxctl parent directory.",
    )
    restart_parser.add_argument(
        "--compose-file",
        action="append",
        default=[],
        help=(
            "Compose file to use. Repeat for overrides. Defaults to the active "
            "running stack files, then deploy/compose.yaml."
        ),
    )
    restart_parser.add_argument(
        "--dev",
        action="store_true",
        help="Use deploy/compose.dev.yaml together with deploy/compose.yaml.",
    )
    restart_parser.add_argument(
        "--no-status",
        action="store_true",
        help="Skip printing docker compose ps after restart.",
    )

    args = parser.parse_args()
    if args.command == "reset-admin-password":
        return _reset_admin_password(
            username=args.username.strip(),
            password=args.password,
            generate=args.generate,
            compose_file=Path(args.compose_file),
            project_directory=Path(args.project_directory),
        )
    if args.command == "update":
        return _run_update(
            project_root=Path(args.project_root),
            check_only=args.check_only,
            force=args.force,
            non_interactive=args.non_interactive,
        )
    if args.command == "restart":
        return _restart_stack(
            project_root=Path(args.project_root),
            compose_files=[Path(path) for path in args.compose_file],
            dev=args.dev,
            services=args.services,
            show_status=not args.no_status,
        )
    return 1


def _reset_admin_password(
    *,
    username: str,
    password: str | None,
    generate: bool,
    compose_file: Path,
    project_directory: Path,
) -> int:
    if not username:
        print("Username is required.", file=sys.stderr)
        return 2
    if not compose_file.exists():
        print(f"Compose file not found: {compose_file}", file=sys.stderr)
        return 2
    if not project_directory.exists():
        print(f"Project directory not found: {project_directory}", file=sys.stderr)
        return 2

    if generate:
        password = _generate_password()
        print("Generated password:", password)
    elif not password:
        password = _prompt_password()

    if not password:
        print("Password is required.", file=sys.stderr)
        return 2

    snippet = r'''
from __future__ import annotations

import sys
import psycopg
from app.core.settings import get_settings
from app.services.audit import log_admin_event
from app.services.auth import hash_password


def main() -> int:
    username = sys.argv[1].strip()
    new_password = sys.argv[2]
    settings = get_settings()
    with psycopg.connect(settings.db_dsn, autocommit=True) as connection:
        with connection.cursor() as cursor:
            cursor.execute(
                """
                SELECT id, username, is_owner
                FROM admin_users
                WHERE username = %(username)s
                """,
                {"username": username},
            )
            row = cursor.fetchone()
            if not row:
                print(f"Admin account {username!r} was not found.", file=sys.stderr)
                return 3
            cursor.execute(
                """
                UPDATE admin_users
                SET password_hash = %(password_hash)s,
                    updated_at = NOW()
                WHERE username = %(username)s
                RETURNING id, username, is_owner
                """,
                {
                    "username": username,
                    "password_hash": hash_password(new_password),
                },
            )
            updated = cursor.fetchone()
        if updated:
            role = "owner" if updated[2] else "admin"
            print(f"Updated {updated[1]!r} ({role}) password successfully.")
            log_admin_event(
                connection,
                event_type="admin.password_reset_cli",
                actor_username="server-cli",
                target_kind="admin",
                target_value=updated[1],
                message="Server-side CLI password reset",
            )
            return 0
    print(f"Failed to update {username!r}.", file=sys.stderr)
    return 4


if __name__ == "__main__":
    raise SystemExit(main())
'''

    command = [
        "docker",
        "compose",
        "--project-directory",
        str(project_directory),
        "-f",
        str(compose_file),
        "exec",
        "-T",
        "-w",
        APP_WORKDIR,
        "app",
        "python3",
        "-c",
        snippet,
        username,
        password,
    ]

    completed = subprocess.run(command, text=True, capture_output=True)
    if completed.stdout.strip():
        print(completed.stdout.rstrip())
    if completed.returncode != 0:
        if completed.stderr.strip():
            print(completed.stderr.rstrip(), file=sys.stderr)
        return completed.returncode

    print()
    print("Recovery paths available:")
    print("  1. Email reset through Brevo SMTP")
    print("  2. Owner/admin password change inside OmniPBX")
    print("  3. CLI reset on the server with omnipbxctl")
    return 0


def _prompt_password() -> str:
    first = getpass.getpass("New password: ")
    second = getpass.getpass("Confirm password: ")
    if first != second:
        print("Passwords do not match.", file=sys.stderr)
        return ""
    return first


def _generate_password(length: int = 20) -> str:
    alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()-_=+"
    return "".join(secrets.choice(alphabet) for _ in range(length))


def _run_update(
    *,
    project_root: Path,
    check_only: bool,
    force: bool,
    non_interactive: bool,
) -> int:
    update_script = project_root / "scripts" / "update.sh"
    if not update_script.exists():
        print(f"Update script not found: {update_script}", file=sys.stderr)
        return 2

    command = ["bash", str(update_script), "--project-root", str(project_root)]
    if check_only:
        command.append("--check-only")
    if force:
        command.append("--force")
    if non_interactive:
        command.append("--non-interactive")

    completed = subprocess.run(command, env=os.environ.copy())
    return completed.returncode


def _restart_stack(
    *,
    project_root: Path,
    compose_files: list[Path],
    dev: bool,
    services: list[str],
    show_status: bool,
) -> int:
    project_root = project_root.resolve()
    if not project_root.exists():
        print(f"Project root not found: {project_root}", file=sys.stderr)
        return 2

    selected_files = _select_compose_files(
        project_root=project_root,
        compose_files=compose_files,
        dev=dev,
    )
    for compose_file in selected_files:
        if not compose_file.exists():
            print(f"Compose file not found: {compose_file}", file=sys.stderr)
            return 2

    service_names = [service.strip() for service in services if service.strip()]
    if not service_names:
        service_names = list(DEFAULT_SERVICES)

    print("Restarting OmniPBX stack...", flush=True)
    print("Compose files:", flush=True)
    for compose_file in selected_files:
        print(f"  - {compose_file}", flush=True)
    print(f"Services: {' '.join(service_names)}", flush=True)

    command = _compose_command(selected_files) + ["restart", *service_names]
    completed = subprocess.run(command, cwd=project_root, env=os.environ.copy())
    if completed.returncode != 0:
        return completed.returncode

    if show_status:
        _wait_for_services(selected_files, service_names, cwd=project_root)
        print()
        status_command = _compose_command(selected_files) + ["ps"]
        status = subprocess.run(status_command, cwd=project_root, env=os.environ.copy())
        return status.returncode
    return 0


def _select_compose_files(
    *,
    project_root: Path,
    compose_files: list[Path],
    dev: bool,
) -> list[Path]:
    if compose_files:
        return [_resolve_project_path(project_root, path) for path in compose_files]

    compose_file = project_root / "deploy" / "compose.yaml"
    dev_compose_file = project_root / "deploy" / "compose.dev.yaml"
    if dev:
        return [compose_file, dev_compose_file]

    active_files = _active_compose_files(project_root)
    if active_files:
        return active_files

    return [compose_file]


def _active_compose_files(project_root: Path) -> list[Path]:
    completed = subprocess.run(
        [
            "docker",
            "inspect",
            "omnipbx-app",
            "--format",
            '{{ index .Config.Labels "com.docker.compose.project.config_files" }}',
        ],
        text=True,
        capture_output=True,
    )
    if completed.returncode != 0:
        return []

    files = []
    for raw_file in completed.stdout.strip().split(","):
        if not raw_file:
            continue
        compose_file = _resolve_project_path(project_root, Path(raw_file))
        if compose_file.exists():
            files.append(compose_file)
    return files


def _resolve_project_path(project_root: Path, path: Path) -> Path:
    if path.is_absolute():
        return path
    return (project_root / path).resolve()


def _compose_command(compose_files: list[Path]) -> list[str]:
    command = ["docker", "compose", "--progress", "plain"]
    for compose_file in compose_files:
        command.extend(["-f", str(compose_file)])
    return command


def _wait_for_services(
    compose_files: list[Path],
    services: list[str],
    *,
    cwd: Path,
    timeout_seconds: int = 30,
) -> None:
    deadline = time.monotonic() + timeout_seconds
    service_ids = _compose_service_ids(compose_files, services, cwd=cwd)
    if not service_ids:
        return

    while time.monotonic() < deadline:
        if _services_ready(service_ids):
            return
        time.sleep(1)


def _compose_service_ids(
    compose_files: list[Path],
    services: list[str],
    *,
    cwd: Path,
) -> list[str]:
    command = _compose_command(compose_files) + ["ps", "-q", *services]
    completed = subprocess.run(command, cwd=cwd, text=True, capture_output=True)
    if completed.returncode != 0:
        return []
    return [line.strip() for line in completed.stdout.splitlines() if line.strip()]


def _services_ready(container_ids: list[str]) -> bool:
    for container_id in container_ids:
        completed = subprocess.run(
            [
                "docker",
                "inspect",
                "--format",
                "{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}",
                container_id,
            ],
            text=True,
            capture_output=True,
        )
        if completed.returncode != 0:
            return False
        state = completed.stdout.strip().split()
        status = state[0] if state else ""
        health = state[1] if len(state) > 1 else ""
        if status != "running":
            return False
        if health in {"starting", "unhealthy"}:
            return False
    return True


if __name__ == "__main__":
    raise SystemExit(main())
